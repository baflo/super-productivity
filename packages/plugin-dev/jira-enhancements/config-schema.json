{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "title": "Workflow Rules",
      "description": "Each rule runs its actions when its trigger fires and all conditions match. Leave empty to use the built-in defaults (Jira imports not scheduled to Today, project picker on import in a project).",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "trigger": {
            "type": "string",
            "title": "Trigger",
            "enum": ["taskCreated"],
            "default": "taskCreated"
          },
          "conditions": {
            "type": "array",
            "title": "Conditions (all must match)",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Condition",
                  "enum": ["isFromProvider", "hasProject", "titleContains", "hasTag"]
                },
                "value": {
                  "type": "string",
                  "title": "Value"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "title": "Actions (run in order)",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Action",
                  "enum": [
                    "unschedule",
                    "scheduleToday",
                    "addTag",
                    "showSnack",
                    "moveToProjectViaDialog"
                  ]
                },
                "value": {
                  "type": "string",
                  "title": "Value"
                }
              }
            }
          }
        }
      }
    }
  }
}
